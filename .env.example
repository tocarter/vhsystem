# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Local: "pglite:.data/pglite" uses an in-process database (no install).
# Vercel: a hosted Postgres URL (Neon, Supabase, Vercel Postgres).
DATABASE_URL=pglite:.data/pglite

# Long random string used to sign login cookies and attachment URLs.
# Required on Vercel. Local preview can omit it.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Google OAuth client (type: Web application).
# Authorised redirect URI must be exactly <APP_ORIGIN>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public origin of the deployment. On Vercel this is inferred, but setting it
# explicitly is safer because cookie flags and OAuth redirects depend on it.
APP_ORIGIN=http://localhost:3000

# Comma separated emails that become approved administrators on first sign-in.
# This is the only way to create the first admin. Remove entries once the real
# administrators exist.
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Organisation details, shown on certificates and in emails
# ---------------------------------------------------------------------------

ORG_NAME=Volunteer Team
ORG_CONTACT_EMAIL=team@example.org
ORG_CONTACT_NAME=

# ---------------------------------------------------------------------------
# Evidence photo storage
# ---------------------------------------------------------------------------

# "local" writes to LOCAL_STORAGE_DIR and is intended for development only.
# "s3" works with any S3-compatible private bucket (AWS S3, Cloudflare R2, ...).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/uploads

# S3_ENDPOINT is required for non-AWS providers, e.g.
# https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------

# "console" prints emails to the server log. Use "resend" in production.
EMAIL_DRIVER=console
# RESEND_API_KEY=
# EMAIL_FROM=Volunteer Hours <hours@example.org>
